{
    "$schema": "https://json-schema.org/draft-07/schema",
    "title": "Feed",
    "description": "A feed file for a geographic area",
    "type": "object",
    "properties": {
        "maintainers": {
            "description": "Array of maintainers for a region",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "description": "Name of a maintainer",
                        "type": "string"
                    },
                    "github": {
                        "description": "GitHub username of a maintainer",
                        "type": "string"
                    }
                },
                "required": ["name", "github"]
            }
        },
        "sources": {
            "description": "Array of source feeds for a region",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "description": "Name of a feed",
                        "type": "string",
                        "pattern": "^[^\/ _]*$"
                    },
                    "type": {
                        "description": "The type of source used for this feed",
                        "type": "string",
                        "enum": ["url", "http", "ftp", "mobility-database", "transitland-atlas"]
                    },
                    "spec": {
                        "description": "the format of the feed",
                        "type": "string"
                    },
                    "headers": {
                        "description": "a dictionary of arbitrary headers for use with a URL source.",
                        "type": "object",
                        "additionalProperties": {"type": "string"}
                    },
                    "transitland-atlas-id": {
                        "description": "a Onestop ID provided by the Transitland Atlas project.",
                        "type": "string",
                        "$comment": "fairly lenient Onestop ID check that only looks for the feed prefix. could be improved.",
                        "pattern": "^f-"
                    },
                    "fix": {
                        "description": "fix and drop broken fields",
                        "type": "boolean"
                    },
                    "license": {
                        "description": "License information regarding a feed",
                        "type": "object",
                        "properties": {
                            "url": {
                                "description": "URL regarding a feed's license information",
                                "type": "string"
                            },
                            "spdx-identifier": {
                                "description": "An SPDX ID for the feed's license",
                                "type": "string"
                            }
                        },
                        "minProperties": 1,
                        "maxProperties": 2
                    }

                },
                "dependencies": {
                    "skip-reason": ["skip"]
                },
                "allOf": [
                    {
                        "$comment": "I think this works? url should only be 'live' types while http is basically just gtfs at the moment",
                        "if": {
                            "properties": {
                                "type": {"enum": ["url", "mobility-database", "transitland-atlas", "ftp"]}
                            }
                        },
                        "then": {
                            "properties": {
                                "spec": {"enum": ["gbfs", "gtfs-rt", "netex", "siri", "siri_json"]}
                            }
                        }
                    },
                    {
                        "$comment": "then we constrain http type feeds to gtfs only",
                        "if": {
                            "properties": {
                                "type": {"const": "http"}
                            }
                        },
                        "then": {
                            "properties": {
                                "spec": {"const": "gtfs"}
                            }
                        }
                    }
                ],
                "required": ["name", "type"]
            }
        }
    },
    "required": ["maintainers", "sources"]
}
